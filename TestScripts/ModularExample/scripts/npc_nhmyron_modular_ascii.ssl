// ============================================================
// [8] MASTER PROCEDURES (unique to this NPC)
// ============================================================

procedure start begin
  if (script_is_running) then begin
    DEBUG_PRINT("Cannot start, already running");
  end else begin
    only_once;
    critter_add_trait(self_obj, TRAIT_TRAIT, PERK_bonus_sm_Guns, 1);
    critter_add_trait(self_obj, TRAIT_TRAIT, PERK_bonus_HtH, 1);
    dude_rep := global_var(TOWN_REP_VAR);
    DEBUG_PRINT_INT("Start rep", dude_rep);
  end
end

procedure map_update_p_proc begin
  // Idle behavior ??? no special logic needed
end

procedure timed_event_p_proc begin
  // No timed events for this NPC
end
