  dude_rep;
  reaction_level;
  temp_check;
  exit_line;

// ============================================================
// [4] FORWARD DECLARATIONS
// ============================================================
procedure start;
procedure spatial_p_proc;
procedure critter_p_proc;
procedure talk_p_proc;
procedure Node001;
procedure Node999;

