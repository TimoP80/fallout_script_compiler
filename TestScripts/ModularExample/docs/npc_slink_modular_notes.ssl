// ============================================================
// SLINK THE SLAVE TRADER — Second NPC using same modular framework
// Location: The Den
// ============================================================

// Configuration: what makes Slink different from N'Myron
// ---
// #define NPC_SCRIPT_NAME       SCRIPT_SLINK
// #define NPC_TOWN_REP_VAR      GVAR_TOWN_REP_DEN
// #define NPC_HAS_COMBAT        0        // No combat, trader
// #define NPC_HAS_BEGGING       1        // Has begging dialogue
// #define NPC_HAS_PICKUP        0        // No hostile pickup reaction
// #define NPC_HAS_DAMAGE        1        // Still tracks damage
// ---

/*
Master script: scripts/npc_slink_modular.ssl

