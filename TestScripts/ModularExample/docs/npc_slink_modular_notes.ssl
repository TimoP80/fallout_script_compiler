  only_once;
  dude_rep := global_var(NPC_TOWN_REP_VAR);
end

procedure spatial_p_proc begin
  if (tile_distance_objs(self_obj, dude_obj) <= 6) then begin
    if (local_var(7) == 0) then begin
      set_local_var(7, 1);
      call NODE_GREETING;
    end
  end
end
*/

// KEY DIFFERENCE: Same procedure modules (npc_defaults, npc_dialogue),
// different config file. The conditional compilation handles the rest.

// Because NPC_HAS_COMBAT = 0, these block out entirely:
//   #ifdef NPC_HAS_COMBAT → false → combat_p_proc not compiled
//   #ifdef NPC_HAS_PICKUP  → false → pickup_p_proc not compiled

// Because NPC_HAS_BEGGING = 1, this gets included from the dialogue module:
//   #ifdef NPC_HAS_BEGGING → true → begging node code included

// This is the power of the modular + conditional compilation pattern:
// The same modules produce completely different NPC scripts based on
// a single configuration file per NPC.